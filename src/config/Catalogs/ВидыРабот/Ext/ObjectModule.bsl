Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Активен = Истина;
КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Наименование = СокрЛП(Наименование);
	Если ПустаяСтрока(Наименование) Тогда
		Отказ = Истина;
		СообщитьОбОшибке(НСтр("ru = 'Укажите наименование вида работ.'"), "Наименование");
	КонецЕсли;
	Если НормативЧасов < 0 Тогда
		Отказ = Истина;
		СообщитьОбОшибке(НСтр("ru = 'Норматив часов не может быть отрицательным.'"), "НормативЧасов");
	КонецЕсли;

КонецПроцедуры

Процедура СообщитьОбОшибке(ТекстСообщения, ИмяПоля)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Поле = ИмяПоля;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

КонецПроцедуры
