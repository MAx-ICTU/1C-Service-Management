
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Результаты = Новый Массив;
	Попытка
		Если СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "stage01-functional") = 0 Тогда
			ВызватьИсключение "Тест разрешён только в отдельной файловой базе stage01-functional*.";
		КонецЕсли;
		ВыполнитьПроверки(Результаты);
	Исключение
		ДобавитьРезультат(Результаты, "harness", Ложь, ОписаниеОшибки());
	КонецПопытки;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Результаты);
	Файл = Новый ЗаписьТекста((КаталогВременныхФайлов() + "stage01-functional.json"), КодировкаТекста.UTF8);
	Файл.Записать(Запись.Закрыть());
	Файл.Закрыть();
КонецПроцедуры

&НаСервере
Процедура ДобавитьРезультат(Результаты, Имя, Успех, Подробности = "")
	Результаты.Добавить(Новый Структура("test,passed,details", Имя, Успех, Подробности));
КонецПроцедуры

&НаСервере
Функция ТекстыСообщений()
	Текст = "";
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Текст = Текст + Сообщение.Текст + Символы.ПС;
	КонецЦикла;
	Возврат Текст;
КонецФункции

&НаСервере
Процедура ОжидатьОтказ(Объект, Имя, ОжидаемыйТекст, Результаты, Удаление = Ложь)
	ТекстыСообщений();
	Ошибка = "";
	Попытка
		Если Удаление Тогда
			Объект.Удалить();
		Иначе
			Объект.Записать();
		КонецЕсли;
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;
	Сообщения = ТекстыСообщений();
	ДобавитьРезультат(Результаты, Имя, НЕ ПустаяСтрока(Ошибка) И СтрНайти(Сообщения, ОжидаемыйТекст) > 0, Сообщения + Ошибка);
КонецПроцедуры

&НаСервере
Функция НовыйЭлемент(Менеджер, Имя)
	Элемент = Менеджер.СоздатьЭлемент();
	Элемент.Заполнить(Неопределено);
	Элемент.Наименование = Имя;
	Возврат Элемент;
КонецФункции

&НаСервере
Функция НовоеОборудование(Клиент, Номер, Серийный = "", Производитель = "")
	Элемент = НовыйЭлемент(Справочники.Оборудование, "Тест " + Номер + Серийный);
	Элемент.Клиент = Клиент;
	Элемент.Модель = "Модель теста";
	Элемент.ИнвентарныйНомер = Номер;
	Элемент.СерийныйНомер = Серийный;
	Элемент.Производитель = Производитель;
	Возврат Элемент;
КонецФункции

&НаСервере
Функция ПовторитьСтроку(Текст, Количество)
	Результат = "";
	Для Номер = 1 По Количество Цикл
		Результат = Результат + Текст;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ЧислоРолейПользователя(Пользователь)
	КоличествоРолей = 0;
	Для Каждого Роль Из Пользователь.Роли Цикл
		КоличествоРолей = КоличествоРолей + 1;
	КонецЦикла;
	Возврат КоличествоРолей;
КонецФункции

&НаСервере
Процедура ВыполнитьПроверки(Результаты)
	Альфа = НовыйЭлемент(Справочники.Клиенты, "  Альфа  ");
	ДобавитьРезультат(Результаты, "client-default-active", Альфа.Активен);
	Альфа.Телефон = "+7 (000) 000-00-00";
	Альфа.ЭлектроннаяПочта = "alpha@example.invalid";
	Альфа.Адрес = "Тестовый адрес";
	Альфа.Комментарий = "Тест этапа 01";
	Альфа.Записать();
	Чтение = Альфа.Ссылка.ПолучитьОбъект();
	ДобавитьРезультат(Результаты, "client-round-read", Чтение.Наименование = "Альфа" И Чтение.Телефон = Альфа.Телефон И Чтение.ЭлектроннаяПочта = Альфа.ЭлектроннаяПочта И Чтение.Адрес = Альфа.Адрес И Чтение.Комментарий = Альфа.Комментарий);
	Бета = НовыйЭлемент(Справочники.Клиенты, "Бета");
	Бета.Записать();
	ДобавитьРезультат(Результаты, "client-no-contacts", НЕ Бета.Ссылка.Пустая());
	Для Каждого ИмяСправочника Из СтрРазделить("Клиенты,Инженеры,ВидыРабот,Оборудование", ",") Цикл
		Пустой = НовыйЭлемент(Справочники[ИмяСправочника], "   ");
		ОжидатьОтказ(Пустой, "empty-name-" + ИмяСправочника, "Укажите наименование", Результаты);
		ДобавитьРезультат(Результаты, "default-active-" + ИмяСправочника, Пустой.Активен);
	КонецЦикла;
	Петров = НовыйЭлемент(Справочники.Инженеры, "Петров");
	Петров.Телефон = "тест";
	Петров.Специализация = "Кондиционеры";
	Петров.Записать();
	Сидоров = НовыйЭлемент(Справочники.Инженеры, "Сидоров");
	Сидоров.Записать();
	ДобавитьРезультат(Результаты, "engineers-empty-uuid", НЕ Петров.Ссылка.Пустая() И НЕ Сидоров.Ссылка.Пустая());
	Петров.Активен = Ложь;
	Петров.Записать();
	Петров.Записать();
	ДобавитьРезультат(Результаты, "engineer-inactive-preserved", НЕ Петров.Ссылка.Активен);
	Чтение = Петров.Ссылка.ПолучитьОбъект();
	ДобавитьРезультат(Результаты, "engineer-fields-preserved", Чтение.Телефон = Петров.Телефон И Чтение.Специализация = Петров.Специализация);
	Пользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Если Пользователи.Количество() = 0 Тогда
		// Служебная роль и оба пользователя разрешены только в отдельном тестовом контуре.
		РольАдминистратора = Метаданные.Роли.Найти("Stage01TestAdmin");
		Если РольАдминистратора = Неопределено Тогда
			ВызватьИсключение "В тестовой конфигурации не создана служебная роль Stage01TestAdmin.";
		КонецЕсли;
		АдминистраторТеста = ПользователиИнформационнойБазы.СоздатьПользователя();
		АдминистраторТеста.Имя = "Stage01Admin";
		АдминистраторТеста.АутентификацияСтандартная = Истина;
		// Учебная лицензия допускает только стандартную аутентификацию с пустым паролем.
		АдминистраторТеста.Пароль = "";
		АдминистраторТеста.Роли.Добавить(РольАдминистратора);
		АдминистраторТеста.Записать();
		ДобавитьРезультат(Результаты, "test-admin-created", ЧислоРолейПользователя(АдминистраторТеста) = 1);
		Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
		Пользователь.Имя = "Stage01Fixture";
		Пользователь.АутентификацияСтандартная = Истина;
		Пользователь.Пароль = "";
		Пользователь.Записать();
		ДобавитьРезультат(Результаты, "test-user-no-roles", ЧислоРолейПользователя(Пользователь) = 0);
		Пользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
	КонецЕсли;
	Если Пользователи.Количество() > 0 Тогда
		Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени("Stage01Fixture");
		Если Пользователь = Неопределено Тогда
			ВызватьИсключение "Не найден разрешённый тестовый пользователь Stage01Fixture.";
		КонецЕсли;
		Идентификатор = Пользователь.УникальныйИдентификатор;
		Петров.Активен = Истина;
		Петров.ИдентификаторПользователяИБ = Идентификатор;
		Петров.Записать();
		Петров.Записать();
		ДобавитьРезультат(Результаты, "engineer-uuid-excludes-self", Петров.Ссылка.ИдентификаторПользователяИБ = Идентификатор);
		Сидоров.ИдентификаторПользователяИБ = Идентификатор;
		ОжидатьОтказ(Сидоров, "engineer-active-uuid-duplicate", "уже связан", Результаты);
		Сидоров.Активен = Ложь;
		Сидоров.Записать();
		Сидоров.Активен = Истина;
		ОжидатьОтказ(Сидоров, "engineer-reactivation-uuid", "уже связан", Результаты);
		Петров.УстановитьПометкуУдаления(Истина);
		ОжидатьОтказ(Сидоров, "engineer-marked-active-uuid", "уже связан", Результаты);
	Иначе
		ДобавитьРезультат(Результаты, "engineer-nonempty-uuid", Неопределено, "Нет пользователей ИБ. Учётные связи для теста не выдумывались.");
	КонецЕсли;
	Диагностика = НовыйЭлемент(Справочники.ВидыРабот, "Диагностика");
	Диагностика.НормативЧасов = 0;
	Диагностика.Описание = "Проверка оборудования";
	Диагностика.Записать();
	ДобавитьРезультат(Результаты, "norm-zero", Диагностика.Ссылка.НормативЧасов = 0);
	Диагностика.НормативЧасов = 1.5;
	Диагностика.Записать();
	ДобавитьРезультат(Результаты, "norm-fraction", Диагностика.Ссылка.НормативЧасов = 1.5);
	Диагностика.НормативЧасов = -1;
	ОжидатьОтказ(Диагностика, "norm-negative", "не может быть отрицательным", Результаты);
	Диагностика.НормативЧасов = 1.5;
	Диагностика.Активен = Ложь;
	Диагностика.Записать();
	Диагностика.Записать();
	ДобавитьРезультат(Результаты, "work-inactive-description-preserved", НЕ Диагностика.Ссылка.Активен И Диагностика.Ссылка.Описание = Диагностика.Описание);
	Первый = НовоеОборудование(Альфа.Ссылка, "  D-001  ", "  SN-1  ", "  Марка  ");
	Первый.ДатаУстановки = Дата(2026, 10, 25);
	Первый.АдресУстановки = "Тестовый адрес установки";
	Первый.Комментарий = "Тест оборудования";
	Первый.Записать();
	Чтение = Первый.Ссылка.ПолучитьОбъект();
	ДобавитьРезультат(Результаты, "equipment-round-read", Чтение.Клиент = Альфа.Ссылка И Чтение.ИнвентарныйНомер = "D-001" И Чтение.СерийныйНомер = "SN-1" И Чтение.Производитель = "Марка" И Чтение.ДатаУстановки = Дата(2026, 10, 25) И Чтение.Комментарий = Первый.Комментарий И Чтение.АдресУстановки = Первый.АдресУстановки);
	Первый.Записать();
	ДобавитьРезультат(Результаты, "inventory-excludes-self", НЕ Первый.Ссылка.Пустая());
	Дубль = НовоеОборудование(Альфа.Ссылка, "  d-001  ");
	ОжидатьОтказ(Дубль, "inventory-case-trim", "инвентарным номером", Результаты);
	ДругойКлиент = НовоеОборудование(Бета.Ссылка, "D-001");
	ДругойКлиент.Записать();
	ДобавитьРезультат(Результаты, "inventory-other-client", НЕ ДругойКлиент.Ссылка.Пустая());
	Первый.Активен = Ложь;
	Первый.Записать();
	ОжидатьОтказ(Дубль, "inventory-inactive", "инвентарным номером", Результаты);
	Первый.УстановитьПометкуУдаления(Истина);
	ОжидатьОтказ(Дубль, "inventory-deletion-mark", "инвентарным номером", Результаты);
	ДобавитьРезультат(Результаты, "equipment-inactive-preserved", НЕ Первый.Ссылка.Активен);
	БезКлиента = НовоеОборудование(Справочники.Клиенты.ПустаяСсылка(), "X");
	ОжидатьОтказ(БезКлиента, "equipment-client-required", "Укажите клиента", Результаты);
	БезМодели = НовоеОборудование(Альфа.Ссылка, "X");
	БезМодели.Модель = "  ";
	ОжидатьОтказ(БезМодели, "equipment-model-required", "Укажите модель", Результаты);
	БезНомеров = НовоеОборудование(Альфа.Ссылка, " ", " ");
	ОжидатьОтказ(БезНомеров, "equipment-number-required", "хотя бы один номер", Результаты);
	ТолькоСерийный = НовоеОборудование(Бета.Ссылка, "", " sn-1 ", " марка ");
	ТекстыСообщений();
	ТолькоСерийный.Записать();
	Сообщения = ТекстыСообщений();
	ДобавитьРезультат(Результаты, "serial-warning-global-inactive-marked", НЕ ТолькоСерийный.Ссылка.Пустая() И СтрНайти(Сообщения, "Запись разрешена") > 0, Сообщения);
	БезПроизводителя = НовоеОборудование(Альфа.Ссылка, "", "UNKNOWN");
	БезПроизводителя.Записать();
	ДубльБезПроизводителя = НовоеОборудование(Бета.Ссылка, "", " unknown ");
	ТекстыСообщений();
	ДубльБезПроизводителя.Записать();
	Сообщения = ТекстыСообщений();
	ДобавитьРезультат(Результаты, "serial-warning-empty-manufacturer", НЕ ДубльБезПроизводителя.Ссылка.Пустая() И СтрНайти(Сообщения, "без указанного производителя") > 0, Сообщения);
	ТекстыСообщений();
	БезПроизводителя.Записать();
	ДобавитьРезультат(Результаты, "serial-warning-excludes-self-and-detects-other", СтрНайти(ТекстыСообщений(), "Запись разрешена") > 0);
	ДругойПроизводитель = НовоеОборудование(Бета.Ссылка, "", "SN-1", "Другая марка");
	ТекстыСообщений();
	ДругойПроизводитель.Записать();
	ДобавитьРезультат(Результаты, "serial-different-manufacturer-no-warning", ПустаяСтрока(ТекстыСообщений()));
	ДругойПроизводитель.Записать();
	ДобавитьРезультат(Результаты, "serial-only-self-no-warning", ПустаяСтрока(ТекстыСообщений()));
	ВнутреннийПробел = НовоеОборудование(Альфа.Ссылка, "D- 001");
	ВнутреннийПробел.Записать();
	ДобавитьРезультат(Результаты, "inventory-inner-spaces-preserved", НЕ ВнутреннийПробел.Ссылка.Пустая());
	Альфа.Активен = Ложь;
	Альфа.Записать();
	Альфа.Записать();
	ДобавитьРезультат(Результаты, "client-deactivation-keeps-reference", НЕ Альфа.Ссылка.Активен И Первый.Ссылка.Клиент = Альфа.Ссылка);
	Альфа.УстановитьПометкуУдаления(Истина);
	ДобавитьРезультат(Результаты, "client-marking-keeps-reference", Альфа.Ссылка.ПометкаУдаления И Первый.Ссылка.Клиент = Альфа.Ссылка);
	ОжидатьОтказ(Альфа, "client-physical-delete-blocked", "Нельзя удалить клиента", Результаты, Истина);
	ДобавитьРезультат(Результаты, "client-still-exists", Альфа.Ссылка.ПолучитьОбъект() <> Неопределено);
	Граница = НовыйЭлемент(Справочники.Клиенты, ПовторитьСтроку("Н", 151));
	Граница.Телефон = ПовторитьСтроку("1", 31);
	Граница.ЭлектроннаяПочта = ПовторитьСтроку("a", 255);
	Граница.Адрес = ПовторитьСтроку("А", 301);
	Граница.Комментарий = ПовторитьСтроку("К", 2000);
	Граница.Записать();
	Чтение = Граница.Ссылка.ПолучитьОбъект();
	ДобавитьРезультат(Результаты, "client-string-boundaries", СтрДлина(Чтение.Наименование) = 150 И СтрДлина(Чтение.Телефон) = 30 И СтрДлина(Чтение.ЭлектроннаяПочта) = 254 И СтрДлина(Чтение.Адрес) = 300 И СтрДлина(Чтение.Комментарий) = 2000);
	ГраницаОборудования = НовоеОборудование(Бета.Ссылка, ПовторитьСтроку("И", 41), ПовторитьСтроку("С", 81), ПовторитьСтроку("П", 101));
	ГраницаОборудования.Модель = ПовторитьСтроку("М", 101);
	ГраницаОборудования.АдресУстановки = ПовторитьСтроку("А", 301);
	ГраницаОборудования.Комментарий = ПовторитьСтроку("К", 2000);
	ГраницаОборудования.ДатаУстановки = Дата(2026, 10, 25, 15, 30, 45);
	ГраницаОборудования.Записать();
	Чтение = ГраницаОборудования.Ссылка.ПолучитьОбъект();
	ДобавитьРезультат(Результаты, "equipment-string-boundaries", СтрДлина(Чтение.ИнвентарныйНомер) = 40 И СтрДлина(Чтение.СерийныйНомер) = 80 И СтрДлина(Чтение.Производитель) = 100 И СтрДлина(Чтение.Модель) = 100 И СтрДлина(Чтение.АдресУстановки) = 300 И СтрДлина(Чтение.Комментарий) = 2000);
	ДобавитьРезультат(Результаты, "date-without-time", Чтение.ДатаУстановки = Дата(2026, 10, 25));
	ДобавитьРезультат(Результаты, "completed", Истина);
КонецПроцедуры
