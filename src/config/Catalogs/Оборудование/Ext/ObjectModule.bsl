Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Активен = Истина;
КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Наименование = СокрЛП(Наименование);
	Модель = СокрЛП(Модель);
	ИнвентарныйНомер = СокрЛП(ИнвентарныйНомер);
	СерийныйНомер = СокрЛП(СерийныйНомер);
	Производитель = СокрЛП(Производитель);

	Если ПустаяСтрока(Наименование) Тогда
		Отказ = Истина;
		СообщитьОПроверке(НСтр("ru = 'Укажите наименование оборудования.'"), "Наименование");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Клиент) Тогда
		Отказ = Истина;
		СообщитьОПроверке(НСтр("ru = 'Укажите клиента оборудования.'"), "Клиент");
	КонецЕсли;
	Если ПустаяСтрока(Модель) Тогда
		Отказ = Истина;
		СообщитьОПроверке(НСтр("ru = 'Укажите модель оборудования.'"), "Модель");
	КонецЕсли;
	Если ПустаяСтрока(ИнвентарныйНомер) И ПустаяСтрока(СерийныйНомер) Тогда
		Отказ = Истина;
		СообщитьОПроверке(
			НСтр("ru = 'Укажите хотя бы один номер: инвентарный или серийный.'"), "ИнвентарныйНомер");
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ПроверитьИнвентарныйНомер(Отказ);
	Если НЕ Отказ Тогда
		ПредупредитьОСерийномДубле();
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИнвентарныйНомер(Отказ)

	Если ПустаяСтрока(ИнвентарныйНомер) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Оборудование.ИнвентарныйНомер
		|ИЗ
		| Справочник.Оборудование КАК Оборудование
		|ГДЕ
		| Оборудование.Клиент = &Клиент
		| И Оборудование.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	НомерДляСравнения = ВРег(ИнвентарныйНомер);
	// Сравнение сохраняет внутренние пробелы и учитывает крайние пробелы старых записей.
	// Неактивные и помеченные элементы намеренно входят в выборку.
	Пока Выборка.Следующий() Цикл
		Если ВРег(СокрЛП(Выборка.ИнвентарныйНомер)) = НомерДляСравнения Тогда
			Отказ = Истина;
			СообщитьОПроверке(
				НСтр("ru = 'У этого клиента уже есть оборудование с таким инвентарным номером.'"),
				"ИнвентарныйНомер");
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПредупредитьОСерийномДубле()

	Если ПустаяСтрока(СерийныйНомер) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Оборудование.СерийныйНомер,
		| Оборудование.Производитель
		|ИЗ
		| Справочник.Оборудование КАК Оборудование
		|ГДЕ
		| Оборудование.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	НомерДляСравнения = ВРег(СерийныйНомер);
	ПроизводительДляСравнения = ВРег(Производитель);
	Пока Выборка.Следующий() Цикл
		Если ВРег(СокрЛП(Выборка.СерийныйНомер)) = НомерДляСравнения
			И ВРег(СокрЛП(Выборка.Производитель)) = ПроизводительДляСравнения Тогда
			Если ПустаяСтрока(Производитель) Тогда
				ТекстПредупреждения = НСтр("ru = 'Найдено оборудование с таким серийным номером без указанного производителя. Запись разрешена.'");
			Иначе
				ТекстПредупреждения = НСтр("ru = 'Найдено оборудование с таким производителем и серийным номером. Запись разрешена.'");
			КонецЕсли;
			СообщитьОПроверке(ТекстПредупреждения, "СерийныйНомер");
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СообщитьОПроверке(ТекстСообщения, ИмяПоля)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Поле = ИмяПоля;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

КонецПроцедуры
