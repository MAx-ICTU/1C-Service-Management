Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Активен = Истина;
КонецПроцедуры

Процедура ПередУдалением(Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Оборудование.Ссылка
		|ИЗ
		| Справочник.Оборудование КАК Оборудование
		|ГДЕ
		| Оборудование.Клиент = &Клиент";
	Запрос.УстановитьПараметр("Клиент", Ссылка);
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Нельзя удалить клиента: на него ссылается оборудование. Можно отключить признак Активен.'");
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	Наименование = СокрЛП(Наименование);
	Если ПустаяСтрока(Наименование) Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Укажите наименование клиента.'");
		Сообщение.Поле = "Наименование";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
	КонецЕсли;
КонецПроцедуры
