Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Активен = Истина;
КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Наименование = СокрЛП(Наименование);
	Если ПустаяСтрока(Наименование) Тогда
		Отказ = Истина;
		СообщитьОбОшибке(НСтр("ru = 'Укажите наименование инженера.'"), "Наименование");
	КонецЕсли;

	ПустойИдентификатор = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Если Отказ ИЛИ НЕ Активен ИЛИ ИдентификаторПользователяИБ = ПустойИдентификатор Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Инженеры.Ссылка
		|ИЗ
		| Справочник.Инженеры КАК Инженеры
		|ГДЕ
		| Инженеры.Активен
		| И Инженеры.ИдентификаторПользователяИБ = &Идентификатор
		| И Инженеры.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторПользователяИБ);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Отказ = Истина;
		СообщитьОбОшибке(
			НСтр("ru = 'Этот пользователь информационной базы уже связан с активным инженером.'"),
			"ИдентификаторПользователяИБ");
	КонецЕсли;

КонецПроцедуры

Процедура СообщитьОбОшибке(ТекстСообщения, ИмяПоля)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Поле = ИмяПоля;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

КонецПроцедуры
